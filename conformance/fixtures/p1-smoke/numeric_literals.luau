local a = 0x10
local b = 1e3
local c = .5
-- The parser rounds integer literals to a double after unsigned 64-bit saturation.
assert(0x20_0000_0000_0001 == 9007199254740992)
assert(0x20_0000_0000_0003 == 9007199254740996)
assert(0xffff_ffff_ffff_ffff == 18446744073709551616)
assert(0X2_0000_0000_0000_0000 == 18446744073709551616)
assert(0B1_00000000_00000000_00000000_00000000_00000000_00000000_00000000_00000000 == 18446744073709551616)
return a + b + c
