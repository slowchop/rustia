for _, case in ipairs(cases) do
    local ok, value = pcall(case[2])
    local kind = type(value)
    local rendered = (kind == "table" or kind == "function" or kind == "thread") and kind or tostring(value)
    rendered = rendered:gsub("^.-:(%d+): ", "<source>:%1: ", 1)
    local observed = tostring(ok)..":"..kind..":"..rendered
    assert(observed == case[3], case[1]..": "..observed)
end
return "pass"
